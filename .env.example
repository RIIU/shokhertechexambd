# Copy to .env.local and fill in.

# Supabase. Without these the app uses a local JSON file.
#   URL:        Project Settings → Data API → Project URL
#   Secret key: Project Settings → API Keys → Secret keys (sb_secret_…)
#               (a legacy service_role JWT in SUPABASE_SERVICE_ROLE_KEY also works)
# The secret key is SERVER-ONLY: never commit it, never prefix it with NEXT_PUBLIC_.
# The publishable key (sb_publishable_…) is not used by this app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# Signs login cookies. Required in production: 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account, created on first start if no admin exists.
# Without these, development creates 01700000000 / admin12345 (never in production).
ADMIN_PHONE=
ADMIN_PASSWORD=

# Only used without Supabase: where the JSON database file lives (default: ./.data)
# DATA_DIR=/var/lib/shokhertech

# Set to 1 only when testing `next start` over plain http on a LAN IP.
# INSECURE_COOKIES=1
