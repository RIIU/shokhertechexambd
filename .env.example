# Copy to .env.local and fill in.

# Supabase (Project Settings → API). Without these the app uses a local JSON file.
# The service_role key is SECRET: server-only, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Signs login cookies. Required in production: 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account, created on first start if no admin exists.
# Without these, development creates 01700000000 / admin12345 (never in production).
ADMIN_PHONE=
ADMIN_PASSWORD=

# Only used without Supabase: where the JSON database file lives (default: ./.data)
# DATA_DIR=/var/lib/shokhertech

# Set to 1 only when testing `next start` over plain http on a LAN IP.
# INSECURE_COOKIES=1
